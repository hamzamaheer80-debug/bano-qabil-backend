# ===== Server =====
NODE_ENV=development
PORT=5000

# ===== MongoDB Atlas =====
# Get this from Atlas > Connect > Drivers. Include the database name before the "?".
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/auth-api?retryWrites=true&w=majority

# ===== JWT =====
# Use a long, random string in production (e.g. output of: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# ===== OTP =====
OTP_EXPIRES_IN_MINUTES=10
OTP_LENGTH=6

# ===== Email (Nodemailer / SMTP) =====
# Example values below work with a Gmail account + App Password.
# For local testing without real email, create a free inbox at https://mailtrap.io instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
EMAIL_FROM=Auth API <no-reply@yourapp.com>

# ===== CORS =====
# Comma-separated list of origins allowed to call this API. Use * only for local testing.
CLIENT_URL=http://localhost:3000
