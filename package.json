{
  "name": "auth-api",
  "version": "1.0.0",
  "description": "Secure Authentication API with JWT, bcrypt password hashing, and email OTP verification — built with Node.js, Express, MongoDB & Mongoose",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "authentication",
    "jwt",
    "bcrypt",
    "otp",
    "express",
    "mongodb"
  ],
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.3.0",
    "morgan": "^1.10.0",
    "nodemailer": "^10.3.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
